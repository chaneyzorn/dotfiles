// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "cursor_shape": "bar",
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark"
  },
  "buffer_font_size": 15.0,
  "buffer_font_family": "JetBrains Mono",
  "ssh_connections": [
    {
      "host": "chaney-dev.local",
      "args": [],
      "projects": [
        {
          "paths": ["/home/chaney/Projects/ApproachingAI/ataas-works/./"]
        }
      ]
    }
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "which_key": {
    "enabled": true
  },
  "cursor_animation": {},
  "minimap": {
    "show": "auto"
  },
  "use_on_type_format": false,
  "disable_ai": true,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "ui_font_size": 16,
  "lsp": {
    "lua-language-server": {
      "binary": {
        "path": "/usr/bin/lua-language-server",
        "ignore_system_version": false
      }
    }
  },
  "languages": {
    "Lua": {
      "tab_size": 2,
      "preferred_line_length": 120,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["--stdin-filepath", "{buffer_path}", "-"]
        }
      }
    }
  }
}
