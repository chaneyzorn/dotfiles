# All-in-one metacubexd server secrets.
# Copy this file to `.env` and change CONTROL_TOKEN before running.
# CLASH_SECRET is optional; leave it commented out if no backend secret is used.

CONTROL_TOKEN=change-me-control

# Optional: secret for mihomo's Clash API.
# Leave empty if the dashboard/backend does not use a secret.
# CLASH_SECRET=change-me-clash

# Optional read-only GitHub token for authenticated Releases API checks.
# GITHUB_TOKEN=

# Optional: pre-fill the connect form's backend address.
# DEFAULT_BACKEND_URL=http://<host>:17894

TZ=Asia/Shanghai
