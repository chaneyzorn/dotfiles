# Caddy reverse-proxy equivalent for the Kong deployment.
# Domain and upstream addresses are injected via environment variables
# (see .env.example). Wildcard certificates are loaded from config/certs/.

# ---------------------------------------------------------------------------
# Home LAN (*.home.lan)
# ---------------------------------------------------------------------------

adguard.{$DOMAIN} {
	reverse_proxy {$ADGUARD_UPSTREAM}
}

beszel.{$DOMAIN} {
	reverse_proxy {$BESZEL_UPSTREAM}
}

dufs.{$DOMAIN} {
	reverse_proxy {$DUFS_UPSTREAM}
}

gitea.{$DOMAIN} {
	reverse_proxy {$GITEA_UPSTREAM}
}

homarr.{$DOMAIN} {
	reverse_proxy {$HOMARR_UPSTREAM}
}

kong.{$DOMAIN} {
	# Kong Manager itself uses HTTPS with a self-signed certificate.
	reverse_proxy {$KONG_MANAGER_UPSTREAM} {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

kuma.{$DOMAIN} {
	reverse_proxy {$KUMA_UPSTREAM}
}

metacube.{$DOMAIN} {
	reverse_proxy {$METACUBE_UPSTREAM}
}

portainer.{$DOMAIN} {
	# Portainer uses HTTPS with a self-signed certificate.
	reverse_proxy {$PORTAINER_UPSTREAM} {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

pve.{$DOMAIN} {
	# Proxmox VE uses HTTPS with its own self-signed certificate.
	reverse_proxy {$PVE_UPSTREAM} {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

syncthing.{$DOMAIN} {
	# Syncthing uses HTTPS with a self-signed certificate.
	reverse_proxy {$SYNCTHING_UPSTREAM} {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

timecrack.{$DOMAIN} {
	reverse_proxy {$TIMECRACK_UPSTREAM}
}

webdav.{$DOMAIN} {
	# WebDAV COPY/MOVE send a full URL in the Destination header.
	# Rewrite it to a path so these methods work behind the reverse proxy.
	@hasDest header_regexp dest ^https?://[^/]+(.*)$
	request_header @hasDest Destination {re.dest.1}

	reverse_proxy {$WEBDAV_UPSTREAM} {
		header_up X-Real-IP {remote_host}
		header_up REMOTE-HOST {remote_host}
	}
}

wifi.{$DOMAIN} {
	reverse_proxy {$WIFI_ROUTER_UPSTREAM}
}

# ---------------------------------------------------------------------------
# Tailscale network (*.tailscale.lan)
# Same upstreams, different entrypoint and certificate.
# ---------------------------------------------------------------------------

adguard.{$TAILSCALE_DOMAIN} {
	reverse_proxy {$ADGUARD_UPSTREAM}
}

beszel.{$TAILSCALE_DOMAIN} {
	reverse_proxy {$BESZEL_UPSTREAM}
}

dufs.{$TAILSCALE_DOMAIN} {
	reverse_proxy {$DUFS_UPSTREAM}
}

gitea.{$TAILSCALE_DOMAIN} {
	reverse_proxy {$GITEA_UPSTREAM}
}

homarr.{$TAILSCALE_DOMAIN} {
	reverse_proxy {$HOMARR_UPSTREAM}
}

kong.{$TAILSCALE_DOMAIN} {
	reverse_proxy {$KONG_MANAGER_UPSTREAM} {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

kuma.{$TAILSCALE_DOMAIN} {
	reverse_proxy {$KUMA_UPSTREAM}
}

metacube.{$TAILSCALE_DOMAIN} {
	reverse_proxy {$METACUBE_UPSTREAM}
}

portainer.{$TAILSCALE_DOMAIN} {
	reverse_proxy {$PORTAINER_UPSTREAM} {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

pve.{$TAILSCALE_DOMAIN} {
	reverse_proxy {$PVE_UPSTREAM} {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

syncthing.{$TAILSCALE_DOMAIN} {
	reverse_proxy {$SYNCTHING_UPSTREAM} {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

timecrack.{$TAILSCALE_DOMAIN} {
	reverse_proxy {$TIMECRACK_UPSTREAM}
}

webdav.{$TAILSCALE_DOMAIN} {
	@hasDest header_regexp dest ^https?://[^/]+(.*)$
	request_header @hasDest Destination {re.dest.1}

	reverse_proxy {$WEBDAV_UPSTREAM} {
		header_up X-Real-IP {remote_host}
		header_up REMOTE-HOST {remote_host}
	}
}

wifi.{$TAILSCALE_DOMAIN} {
	reverse_proxy {$WIFI_ROUTER_UPSTREAM}
}

# ---------------------------------------------------------------------------
# Wildcard fallbacks: load wildcard certificates and serve a health page.
# ---------------------------------------------------------------------------
*.{$DOMAIN} {
	tls /etc/caddy/certs/wildcard.{$DOMAIN}.crt /etc/caddy/certs/wildcard.{$DOMAIN}.key
	handle {
		respond "Caddy gateway is running."
	}
}

*.{$TAILSCALE_DOMAIN} {
	tls /etc/caddy/certs/wildcard.{$TAILSCALE_DOMAIN}.crt /etc/caddy/certs/wildcard.{$TAILSCALE_DOMAIN}.key
	handle {
		respond "Caddy gateway is running."
	}
}
