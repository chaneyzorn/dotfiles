# Base domains served by Caddy.
DOMAIN=example.lan
TAILSCALE_DOMAIN=tailscale.example.lan

# Upstream addresses used by Caddy.
# Copy this file to `.env` and adjust values for your network.
# Format: host:port for plain HTTP, https://host:port for HTTPS.
# The IPs below are RFC 5737 documentation/examples; replace them.

ADGUARD_UPSTREAM=192.0.2.10:15353
BESZEL_UPSTREAM=192.0.2.10:8090
DUFS_UPSTREAM=192.0.2.10:5000
GITEA_UPSTREAM=192.0.2.10:3280
HOMARR_UPSTREAM=192.0.2.10:7575
KONG_MANAGER_UPSTREAM=https://192.0.2.10:8445
KUMA_UPSTREAM=192.0.2.10:13001
METACUBE_UPSTREAM=192.0.2.10:17895
PORTAINER_UPSTREAM=https://192.0.2.10:9443
PVE_UPSTREAM=https://192.0.2.11:8006
SYNCTHING_UPSTREAM=https://192.0.2.10:8384
TIMECRACK_UPSTREAM=192.0.2.12:5173
WEBDAV_UPSTREAM=192.0.2.10:6065
WIFI_ROUTER_UPSTREAM=192.0.2.1:80
