// ! PLACE YOUR CUSTOM CONFIGURATION ELSEWHERE !

layout {
    gaps 4

    border {
        width 2
    }

    focus-ring {
        width 2
    }
}

window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}

layer-rule {
    background-effect {
        xray false
    }
}

window-rule {
    match app-id="^(dev.duxlabs.shell|com.danklinux.dms)$"
    background-effect {
        xray false
    }
}

// bar-xray off
